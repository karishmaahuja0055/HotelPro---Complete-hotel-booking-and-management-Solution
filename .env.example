# HotelPro India - Environment Variables Template

# Application Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://localhost:27017/hotelpro
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hotelpro

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Indian Payment Gateway Integration (Razorpay)
# Get credentials from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Optional Alternative Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKey
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecret

# Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reservations@hotelpro.in
SMTP_PASS=your_app_specific_email_password
EMAIL_FROM="HotelPro Concierge <reservations@hotelpro.in>"

# Cloud Storage for Hotel Photos (Cloudinary - Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Studio Injection
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
